# Copy to `.env` and fill in ONE provider. `.env` is git-ignored — never commit keys.
#
# LLM_PROVIDER=auto picks: anthropic (if ANTHROPIC_API_KEY is set) -> openai
# (if OPENAI_API_KEY is set) -> soclaas (if SOCLAAS_API_KEY is set) -> offline.
# Offline mode needs no key: the tutor still retrieves and cites passages, but
# answers extractively (no generation).
LLM_PROVIDER=auto

# --- Option A: Anthropic (Claude) ------------------------------------------
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max (answers)
# ANTHROPIC_ROUTER_EFFORT=low      # routing / query-rewrite call
# ANTHROPIC_REFUSAL_FALLBACK=true  # server-side refusal fallback (beta)

# --- Option B: OpenAI or any OpenAI-compatible API -------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # leave empty for api.openai.com
# LLM_MODEL=gpt-4.1-mini
#
# Examples of OpenAI-compatible providers:
#   DeepSeek : OPENAI_BASE_URL=https://api.deepseek.com                            LLM_MODEL=deepseek-chat
#   Qwen     : OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   Ollama   : OPENAI_BASE_URL=http://host.docker.internal:11434/v1  OPENAI_API_KEY=ollama  LLM_MODEL=qwen2.5:7b

# --- Option C: NUS SoC LLM-as-a-Service (SoCLaaS), OpenAI-compatible ------------
SOCLAAS_API_KEY=
# SOCLAAS_URL=https://soclaas-api.comp.nus.edu.sg   # the default
# LLM_MODEL=qwen3.6:35b                             # the default; see /v1/models
# For SoCLaaS bge-m3 embeddings, set EMBEDDING_BACKEND=openai in the Retrieval section below.

# Optional: a cheaper/faster model for the routing + query-rewrite call.
# ROUTER_MODEL=

# --- Retrieval ---------------------------------------------------------------
# local  = multilingual ONNX embedding model baked into the Docker image (default)
# openai = OpenAI-compatible /embeddings endpoint (EMBEDDING_API_KEY, else the OpenAI / SoCLaaS key)
# none   = BM25 keyword retrieval only
EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# TOP_K=6

# --- Limits --------------------------------------------------------------------
# MAX_INPUT_CHARS=2000
# RATE_LIMIT_PER_MINUTE=30
# VERIFY_CLAIMS=true             # fact check: one extra LLM call per answer
# LOG_LEVEL=INFO
